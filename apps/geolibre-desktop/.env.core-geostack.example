# CoRE-GeoStack deployment configuration.
# Copy selected values into .env.local or provide them through the deployment.

# MapLibre style URL for the deployment's satellite/hybrid basemap. When this
# is omitted, CoRE-GeoStack uses the migrated KYL Google hybrid tile endpoint
# through public/basemaps/google-hybrid.json.
VITE_CORE_GEOSTACK_BASEMAP_STYLE_URL=

# Existing CoRE Stack GeoServer root. The application includes this default,
# but keeping it explicit makes environment promotion reviewable.
VITE_CORE_GEOSTACK_API_URL=https://geoserver.core-stack.org/api/v1/
VITE_CORE_GEOSTACK_GEOSERVER_URL=https://geoserver.core-stack.org:8443/geoserver/

# Independent multiscale administrative indexes. Tehsil tiles are designed for
# immediate national context; village tiles start only near their useful zoom.
VITE_CORE_GEOSTACK_TEHSIL_PMTILES_URL=
VITE_CORE_GEOSTACK_TEHSIL_SOURCE_LAYER=tehsils
VITE_CORE_GEOSTACK_VILLAGE_PMTILES_URL=
VITE_CORE_GEOSTACK_VILLAGE_SOURCE_LAYER=villages
VITE_CORE_GEOSTACK_VILLAGE_MIN_ZOOM=9.5
