+// CoRE Stack date-keyed vectors keep one geometry per feature. Register their
+// parsed axis after lazy hydration rather than binding a single synthetic date.
+export function useCoreStackSources(mapControllerRef: RefObject<MapEngine | null>): void {
+  useEffect(() => {
+    const adapters = new Map<string, { key: string; detach: () => void }>();
+    const files = new Map<string, { controller: AbortController; blob?: string }>();
+    let disposed = false;
+    let reconciling = false;
+    const reconcile = () => {
+      if (reconciling || disposed) return;
+      reconciling = true;
+      try {
+        const store = useAppStore.getState();
+        for (const [id, entry] of adapters) {
+          if (!store.layers.some(layer => layer.id === id)) { entry.detach(); adapters.delete(id); }
+        }
+        const activeUrls = new Set<string>();
+        for (const layer of store.layers) {
+          const core = layer.metadata?.corestack as any;
+          const series = core?.timeSeries;
+          if (series?.mode === "date-keyed-series" && series.dates?.length && layer.geojson?.features.length) {
+            const key = JSON.stringify([layer.source, series.dates]);
+            if (adapters.get(layer.id)?.key !== key) {
+              adapters.get(layer.id)?.detach();
+              const adapter: TemporalLayerAdapter = {
+                dimension: series.dateProperty,
+                granularity: "day", displayUnits: ["day"],
+                getTimeValues: () => series.dates,
+                setTime: date => {
+                  const current = useAppStore.getState().layers.find(item => item.id === layer.id);
+                  if (!current?.geojson) return;
+                  const selected = series.dates.reduce((a: string, b: string) =>
+                    Math.abs(Date.parse(a) - date.getTime()) <= Math.abs(Date.parse(b) - date.getTime()) ? a : b);
+                  const field = series.fields.find((item: any) => item.date === selected)?.property;
+                  const geojson = { ...current.geojson, features: current.geojson.features.map(feature => {
+                    const properties = { ...feature.properties };
+                    const previous = properties.__corestack_missing_style;
+                    if (previous) {
+                      for (const name of ["fill", "stroke", "marker-color"]) {
+                        if (Object.prototype.hasOwnProperty.call(previous, name)) properties[name] = previous[name];
+                        else delete properties[name];
+                      }
+                      delete properties.__corestack_missing_style;
+                    }
+                    properties[series.dateProperty] = selected;
+                    properties[series.valueProperty] = field ? properties[field] ?? null : null;
+                    properties.stroke = "#05081c";
+                    return { ...feature, properties };
+                  }) };
+                  const metadata = { ...current.metadata, corestack: { ...(current.metadata.corestack as any), timeSeries: { ...series, date: selected } } };
+                  useAppStore.getState().updateLayer(layer.id, { geojson, metadata, timeFilter: undefined });
+                },
+              };
+              const detach = registerTemporalLayer(layer.id, adapter);
+              adapters.set(layer.id, { key, detach });
+              bindTemporalLayer(layer.id, adapter, mapControllerRef);
+            }
+          }
+          const url = core?.rasterDownload?.url;
+          if (!core?.year || !core?.geoserverLayer?.startsWith("LULC_") || typeof url !== "string") continue;
+          activeUrls.add(url);
+          const cached = files.get(url)?.blob;
+          if (cached && layer.metadata.localBytesUrl !== cached) {
+            store.updateLayer(layer.id, { metadata: { ...layer.metadata, localBytesUrl: cached } });
+          }
+          if (!layer.visible || files.has(url)) continue;
+          const entry = { controller: new AbortController(), blob: undefined as string | undefined };
+          files.set(url, entry);
+          void fetch(url, { signal: entry.controller.signal }).then(async response => {
+            if (!response.ok) throw new Error("Could not load the complete LULC coverage.");
+            const bytes = await response.arrayBuffer();
+            const header = new Uint8Array(bytes, 0, Math.min(4, bytes.byteLength));
+            if (!((header[0] === 73 && header[1] === 73) || (header[0] === 77 && header[1] === 77))) throw new Error("LULC response is not a TIFF.");
+            if (disposed || entry.controller.signal.aborted) return;
+            entry.blob = URL.createObjectURL(new Blob([bytes], { type: "image/tiff" }));
+            for (const sibling of useAppStore.getState().layers) {
+              if ((sibling.metadata?.corestack as any)?.rasterDownload?.url !== url) continue;
+              useAppStore.getState().updateLayer(sibling.id, { metadata: { ...sibling.metadata, localBytesUrl: entry.blob } });
+            }
+          }).catch(() => { if (files.get(url) === entry) files.delete(url); });
+        }
+        for (const [url, entry] of files) {
+          if (activeUrls.has(url)) continue;
+          entry.controller.abort();
+          if (entry.blob) URL.revokeObjectURL(entry.blob);
+          files.delete(url);
+        }
+      } finally { reconciling = false; }
+    };
+    const unsubscribe = useAppStore.subscribe(reconcile);
+    reconcile();
+    return () => {
+      disposed = true;
+      unsubscribe();
+      for (const entry of adapters.values()) entry.detach();
+      for (const entry of files.values()) { entry.controller.abort(); if (entry.blob) URL.revokeObjectURL(entry.blob); }
+    };
+  }, [mapControllerRef]);
+}
