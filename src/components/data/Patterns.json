                            {
                            "signal": "sig_03_03",
                            "Key": "annual_rainfall",
                            "function": "trend",
                            "operator": "<",
                            "value": 0
                            }
                        ]
                        },
                        {
                        "signal": "sig_04",
                        "label": "Monsoon onset variability exceeds 14 days",
                        "expression": "max(day_of_year(monsoon_onset_date)) - min(day_of_year(monsoon_onset_date))",
                        "operator": ">",
                        "value": 14
                        },
                        {
                        "signal": "sig_05",
                        "label": "Cropping intensity is below 1.25",
                        "Key": "cropping_intensity",
                        "operator": "<",
                        "value": 1.25
